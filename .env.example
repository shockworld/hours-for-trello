# Create a Power-Up in https://trello.com/power-ups/admin
TRELLO_POWER_UP_ID=
# Generate Trello API key and a read-only token on an account with access to all client boards.
# Keep BOTH server-side. The token must have read access to board members and cards.
TRELLO_API_KEY=
TRELLO_SERVICE_TOKEN=
# Comma-separated Trello member IDs allowed to create/edit/delete their OWN work logs.
WRITER_MEMBER_IDS=
PUBLIC_ORIGIN=https://hours-for-trello.shockworld.net
PORT=3000
HOST=127.0.0.1
SQLITE_PATH=./data/hours.sqlite
